# ADGE Tennis — External Stat API (STANDALONE, /api/ext/*) for Cloud Run.
# Separate from the coach app: no frontend build, no dist — just the Node server
# modules serving the x-api-key-authed /api/ext/* endpoints from Firestore + GCS.
FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY server/package.json server/
RUN cd server && npm install --omit=dev
COPY server/ server/
EXPOSE 8080
CMD ["node", "server/statApiServer.mjs"]
